{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
  },
  "include": [
    "server/**/*.ts",
    "src/**/*.ts",
    "prisma/db.ts",
    "prisma/contract.d.ts",
  ],
  "exclude": ["node_modules", "dist"],
}
