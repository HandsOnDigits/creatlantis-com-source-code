// use prisma-8

model User {
  @@index(
  expression: sql`lower(username)`,
  unique: true,
  name: "User_username_lower_key"
  )

  id           Int     @id @default(autoincrement())
  email        String  @unique
  username     String
  name         String?
  nameIsPublic Boolean @default(false)

  passwordHash String?
  posts        Post[]
  sessions     Session[]
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.UpdatedAtString

  media Media[]

  uploadReservations UploadReservation[]
}

model Session {
  id               String            @id @onCreate(uuid())
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           Int
  refreshTokenHash String            @unique
  expiresAt        TimestamptzString
  createdAt        TimestamptzString @default(now())
}

model Media {
  id String @id @onCreate(uuid())

  user   User @relation(fields: [userId], references: [id])
  userId Int

  originalKey      String  @unique
  originalFileId   String?
  originalFilename String
  originalMimeType String
  originalSize     BigInt?

  width  Int?
  height Int?

  status             MediaStatus        @default(PENDING_UPLOAD)
  processingAttempts Int                @default(0)
  processingError    String?
  nextAttemptAt      TimestamptzString?
  processedAt        TimestamptzString?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.UpdatedAtString

  variants  MediaVariant[]
  postMedia PostMedia[]

  @@index([userId, createdAt])
  @@index([status, nextAttemptAt])
}

enum MediaStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  READY
  FAILED
  DELETING
}

enum MediaFormat {
  WEBP
  AVIF
}

model MediaVariant {
  id String @id @onCreate(uuid())

  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId String

  format    MediaFormat
  width     Int
  height    Int
  size      BigInt
  objectKey String      @unique
  fileId    String?

  createdAt TimestamptzString @default(now())

  @@unique([mediaId, format, width])
  @@index([mediaId])
}

enum PostType {
  IMAGE
  JOURNAL
  MODEL
}

model Post {
  id        Int               @id @default(autoincrement())
  title     String
  content   String?
  author    User              @relation(fields: [authorId], references: [id])
  authorId  Int
  createdAt TimestamptzString @default(now())
  updatedAt temporal.UpdatedAtString
  type      PostType          @default(IMAGE)

  media    PostMedia[]
  catalogs CatalogPost[]
}

model PostMedia {
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int

  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId String

  position Int @default(0)

  @@id([postId, mediaId])
  @@index([mediaId])
}

model UploadReservation {
  id          String            @id @onCreate(uuid())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  objectKey   String            @unique
  filename    String
  contentType String
  size        BigInt
  expiresAt   TimestamptzString
  createdAt   TimestamptzString @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Catalog {
  id          Int           @id @default(autoincrement())
  name        String
  slug        String        @unique
  description String?
  posts       CatalogPost[]

  createdAt TimestamptzString @default(now())
  updatedAt   temporal.UpdatedAtString

  @@index([name])
}

model CatalogPost {
  catalog   Catalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  catalogId Int

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int

  position  Int               @default(0)
  createdAt TimestamptzString @default(now())

  @@id([catalogId, postId])
  @@index([postId])
  @@index([catalogId, position])
}
