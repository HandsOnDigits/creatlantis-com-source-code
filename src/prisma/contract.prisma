// use prisma-8

enum MediaStatus {
  PENDING_UPLOAD
  UPLOADED
  PROCESSING
  READY
  FAILED
  DELETING
}

enum MediaFormat {
  WEBP
  AVIF
}

enum PostType {
  IMAGE
  JOURNAL
  MODEL
}

enum PostPublicationStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum AvatarStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

model User {
  @@index(
  expression: sql`lower(username)`,
  unique: true,
  name: "User_username_lower_key"
  )

  // Private
  id       Int    @id @default(autoincrement())
  email    String @unique
  username String

  // Optional public (default private)
  name              String?
  nameIsPublic      Boolean @default(false)
  birthDate         Date?
  birthDateIsPublic Boolean @default(false)
  gender            String?
  genderIsPublic    Boolean @default(false)

  // Public
  tagline VarChar(160)?
  avatar UserAvatar?

  passwordHash         String?
  posts                Post[]
  sessions             Session[]
  createdAt            TimestamptzString     @default(now())
  updatedAt            temporal.UpdatedAtString
  profileCustomization ProfileCustomization?
  profileLayout        ProfileLayout?

  media                    Media[]
  uploadReservations       UploadReservation[]
  avatarUploadReservations AvatarUploadReservation[]
}

model UserAvatar {
  id String @id @onCreate(uuid())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int  @unique

  // Currently active avatar in public storage
  publicObjectKey String? @unique
  publicFileId    String?

  // Replacement waiting in private staging storage
  stagingObjectKey String? @unique
  stagingFileId    String?

  originalFilename String?
  mimeType         String?
  size             BigInt?
  width            Int?
  height           Int?

  pendingPublicObjectKey String?      @unique
  status                 AvatarStatus @default(PENDING_APPROVAL)
  rejectionReason        String?

  reviewedAt        TimestamptzString?
  reviewedByAdminId String?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.UpdatedAtString

  @@index([status, createdAt])
}

model ProfileCustomization {
  id String @id @onCreate(uuid())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int  @unique

  // Original BBCode source
  description String @default("")

  // User-defined profile stylesheet
  customCss String @default("")

  createdAt TimestamptzString @default(now())
  updatedAt temporal.UpdatedAtString
}

model ProfileLayout {
  id String @id @onCreate(uuid())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int  @unique

  // Version of the layout structure
  version Int @default(1)

  // Profile widget arrangement
  layout Json @default(json`{}`)

  createdAt TimestamptzString @default(now())
  updatedAt temporal.UpdatedAtString
}

model Session {
  id               String            @id @onCreate(uuid())
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           Int
  refreshTokenHash String            @unique
  expiresAt        TimestamptzString
  createdAt        TimestamptzString @default(now())
}

model Media {
  id String @id @onCreate(uuid())

  user   User @relation(fields: [userId], references: [id])
  userId Int

  originalKey       String  @unique
  originalFileId    String?
  originalFilename  String
  originalMimeType  String
  originalSize      BigInt?
  publicOriginalKey String? @unique // Public bucket key

  width  Int?
  height Int?

  status             MediaStatus        @default(PENDING_UPLOAD)
  processingAttempts Int                @default(0)
  processingError    String?
  nextAttemptAt      TimestamptzString?
  processedAt        TimestamptzString?

  createdAt TimestamptzString @default(now())
  updatedAt temporal.UpdatedAtString

  variants  MediaVariant[]
  postMedia PostMedia[]

  @@index([userId, createdAt])
  @@index([status, nextAttemptAt])
}

model MediaVariant {
  id String @id @onCreate(uuid())

  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId String

  format          MediaFormat
  width           Int
  height          Int
  size            BigInt
  objectKey       String      @unique // Private staging key
  publicObjectKey String?     @unique // Public bucket key
  fileId          String?

  createdAt TimestamptzString @default(now())

  @@unique([mediaId, format, width])
  @@index([mediaId])
}

model Post {
  id                Int                   @id @default(autoincrement())
  title             String
  content           String?
  author            User                  @relation(fields: [authorId], references: [id])
  authorId          Int
  createdAt         TimestamptzString     @default(now())
  updatedAt temporal.UpdatedAtString
  type              PostType              @default(IMAGE)
  publicationStatus PostPublicationStatus @default(PENDING_APPROVAL)

  reviewedAt        TimestamptzString?
  reviewedByAdminId String?
  rejectionReason   String?

  media      PostMedia[]
  categories CategoryPost[]
}

model PostMedia {
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int

  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId String

  position Int @default(0)

  @@id([postId, mediaId])
  @@unique([mediaId])
}

model UploadReservation {
  id          String            @id @onCreate(uuid())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  objectKey   String            @unique
  filename    String
  contentType String
  size        BigInt
  expiresAt   TimestamptzString
  createdAt   TimestamptzString @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AvatarUploadReservation {
  id String @id @onCreate(uuid())

  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int

  objectKey   String @unique
  filename    String
  contentType String
  size        BigInt

  expiresAt TimestamptzString
  createdAt TimestamptzString @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Category {
  id          Int            @id @default(autoincrement())
  name        String
  slug        String         @unique
  description String?
  posts       CategoryPost[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.UpdatedAtString

  @@index([name])
}

model CategoryPost {
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId Int

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int

  position  Int               @default(0)
  createdAt TimestamptzString @default(now())

  @@id([categoryId, postId])
  @@index([postId])
  @@index([categoryId, position])
}
